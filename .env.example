# Development defaults work without copying this file. Production must set a
# new random value, for example: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
# Only list reverse-proxy peer IPs that overwrite X-Forwarded-For.
DJANGO_TRUSTED_PROXY_IPS=
DJANGO_ENABLE_ADMIN=true
DJANGO_SECURE_SSL_REDIRECT=false
# Set these to true only when every production subdomain is HTTPS-only and the
# domain is intended for the browser HSTS preload list.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_BEHIND_HTTPS_PROXY=false
